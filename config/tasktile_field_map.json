      "fields": {
        "institution_name":       { "leaf": "bank.name" },
        "account_type":           { "leaf": "accounts.[].accountType" },
        "account_number":         { "leaf": "accounts.[].accountNumber" },
        "ending_balance":         { "leaf": "accounts.[].endingBalance" },
