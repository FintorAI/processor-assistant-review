        "le_date_issued":    { "leaf": "loanEstimate.dateIssued", "validator": "date" },
        "le_loan_purpose":   { "leaf": "loanEstimate.purpose" },
        "le_loan_type":      { "leaf": "loanEstimate.loanType" },
        "le_loan_product":   { "leaf": "loanEstimate.product" },
